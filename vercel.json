{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/vendor/(.*)", "destination": "/vendor/$1" },
    { "source": "/src/(.*)", "destination": "/src/$1" },
    { "source": "/app/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/app/vendor/(.*)", "destination": "/vendor/$1" },
    { "source": "/app/src/(.*)", "destination": "/src/$1" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/$1" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|gif|webp|json|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
